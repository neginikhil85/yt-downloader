{
  "name": "yt-downloader-pro",
  "version": "2.0.0",
  "description": "Professional YouTube Downloader & Cinema Streamer Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "pack:standalone": "node scripts/pack-clean.js",
    "pack:clean": "node scripts/pack-clean.js"
  },
  "build": {
    "appId": "com.bruno.bruno",
    "productName": "bruno",
    "executableName": "bruno",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "executableName": "bruno",
      "artifactName": "bruno.${ext}",
      "icon": "assets/icon.png",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  },
  "keywords": [
    "youtube",
    "downloader",
    "streamer",
    "electron",
    "video-player"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4"
  }
}
